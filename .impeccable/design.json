  "narrative": {
    "northStar": "The Instrument Panel",
    "overview": "The screen is an instrument panel for a positioning engine. Numbers and states are the subject, and the chrome stays out of their way. An expert should be able to read the state of a run in one glance, from any of the screens, because the same gauge always has the same shape and sits in the same place.\n\nThe panel is dense on purpose: many parameters and series stay visible at once. Colour is rationed so that when something is coloured, it is reporting state. It comes in two equally maintained forms: graphite for the desk, and daylight for a laptop in bright surroundings.",
    "keyCharacteristics": [
      "High density with one strict grid for form rows.",
      "Colour reports state; everything else is neutral.",
      "One component per concept across Real-time, Post-processing and Stream Monitor.",
      "IBM Plex Mono for every number, path, log and code value.",
      "Flat, separated by tone and hairlines."
    ],
    "rules": [
      {
        "name": "The Colour Means State Rule",
        "body": "Colour outside azure controls reports a quality or a lifecycle state. A value that is not a state, such as Ratio, stays neutral.",
        "section": "colors"
      },
      {
        "name": "The Two Layers Rule",
        "body": "Quality describes the solution and lifecycle describes the process. They are defined in one file each and never share a token. A grey \"stopped\" is not a Single solution.",
        "section": "colors"
      },
      {
        "name": "The Daylight Rule",
        "body": "The light theme is the outdoor theme, not a derivative. Text holds 4.5:1 and field outlines 3:1 on their surfaces, and every colour decision is checked in it.",
        "section": "colors"
      },
      {
        "name": "The Word Beside the Dot Rule",
        "body": "A state is always a dot and a word. An error also carries an icon, so it never reads as a Single dot.",
        "section": "colors"
      },
      {
        "name": "The Six Sizes Rule",
        "body": "Only these sizes exist: 10, 11, 12, 14, 16, 24. Fractional sizes and 9px are gone, and Mantine's 9px extra-small Badge counts.",
        "section": "typography"
      },
      {
        "name": "The Caption Floor Rule",
        "body": "10px is for uppercase captions and chart tick labels, and nothing else. Anything a person reads as a sentence or a field name is at least 11px.",
        "section": "typography"
      },
      {
        "name": "The Readout Rule",
        "body": "Every number, path, log line and code value is IBM Plex Mono, referenced through `var(--mantine-font-family-monospace)`.",
        "section": "typography"
      },
      {
        "name": "The Fixed Frame Rule",
        "body": "Panel height comes from the viewport, never from a numeric constant or from a neighbouring column.",
        "section": "layout"
      },
      {
        "name": "The Flat-by-Default Rule",
        "body": "If an element is attached to the page, it has no shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** build a concept once and reuse it on every screen.",
      "**Do** show only values that are true. If a figure is not known, leave it out rather than printing a placeholder such as `Fix: ---`.",
      "**Do** keep the running state visible from anywhere: a dot on the header item for any screen with an active process.",
      "**Do** check every colour change in the light theme as well.",
      "**Do** add `minWidth: 0` to flex children that should truncate."
    ],
    "donts": [
      "**Don't** set input sizes, font sizes or colours per call site; use the theme and tokens.",
      "**Don't** give a log view a numeric height.",
      "**Don't** fill more than one control in a toolbar.",
      "**Don't** use azure for a value that is not a control or a selection.",
      "**Don't** redefine a `dark` ramp index without checking what Mantine maps to it: placeholder and disabled text follow `dark[3]`.",
      "**Don't** convey state by colour alone."
    ]
  }
