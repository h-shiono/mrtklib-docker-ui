# MRTKLIB Web UI — Environment Variables

# UI application version (used as Docker build arg, fed to setuptools_scm)
# APP_VERSION=0.4.3-alpha

# Directory for output files and presets (read-write)
WORKSPACE_DIR=./workspace

# The app runs as this host user/group, so files in WORKSPACE_DIR are yours.
# Use the output of `id -u` / `id -g`. On start, files under WORKSPACE_DIR
# owned by anyone else (e.g. root, from older versions) are chowned to it.
# PUID=0 keeps the old run-as-root behaviour.
# PUID=1000
# PGID=1000

# Directory for input GNSS data files (read-only)
# Set this to your local GNSS data directory, e.g.:
# DATA_DIR=/home/user/gnss-data
DATA_DIR=./data

# NASA Earthdata credentials (for IGS product downloads)
# Register at: https://urs.earthdata.nasa.gov/
# EARTHDATA_USER=
# EARTHDATA_PASSWORD=

# GSI CORS FTP credentials (for Japanese CORS data)
# Register at: https://terras.gsi.go.jp/
# GSI_USER=
# GSI_PASSWORD=

# Alternative: mount your existing ~/.netrc file
# NETRC_FILE=~/.netrc

# CLAS Pipeline serial device (Stream Server tab → CLAS Pipeline)
# One bidirectional port: the receiver sends SBF/L6 and receives RTCM3 on it.
# Uncomment the matching `devices:` line in docker-compose.yml to apply.
# Use stable /dev/serial/by-id/* paths in production — they survive reboots.
# CLAS_INPUT_DEVICE=/dev/ttyUSB0
